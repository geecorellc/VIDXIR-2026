FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Use the system FFmpeg rather than downloading another binary at npm install.
ENV FFMPEG_BIN=/usr/bin/ffmpeg
ENV FFMPEG_PATH=/usr/bin/ffmpeg

COPY package.json package-lock.json ./
# tsx is needed to run the standalone worker, scheduler, and migrations.
RUN npm ci --include=dev --no-audit --no-fund

COPY tsconfig.json ./
COPY src ./src
COPY drizzle-d1 ./drizzle-d1

ENV NODE_ENV=production
USER node
STOPSIGNAL SIGTERM
EXPOSE 8080
CMD ["node", "--import", "tsx", "src/worker/container.ts"]
