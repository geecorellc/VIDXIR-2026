# =============================================================================
# TALLY — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Every provider below is a real integration. If a credential is missing, Tally
# does NOT fake the feature: the API returns a `not_configured` state and the UI
# shows a configuration banner (see src/lib/providers/registry.ts).
# =============================================================================

# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------
# `development` enables mock providers + publish guard. `production` requires
# real providers and refuses to boot with mocks enabled.
NODE_ENV=development

# Public origin of the app. Used for OAuth redirect URIs, email links, and
# Stripe return URLs. No trailing slash.
APP_URL=http://localhost:3000

# Development safety switches (§40). Both MUST be false/unset in production.
# TALLY_USE_MOCK_PROVIDERS: route every external provider through a mock impl.
TALLY_USE_MOCK_PROVIDERS=true
# TALLY_BLOCK_REAL_PUBLISH: hard-block any YouTube upload/publish call, even if
# real OAuth tokens are present. Prevents accidental publishing while testing.
TALLY_BLOCK_REAL_PUBLISH=true
#
# These are enforced, not advisory. With NODE_ENV=production, `lib/env` refuses to
# boot when TALLY_USE_MOCK_PROVIDERS is true — a mock provider silently serving
# production traffic is the failure that looks like success, which is the one worth
# refusing to start over. TALLY_BLOCK_REAL_PUBLISH is allowed in production (an
# operator may deliberately want a dry-run deployment) but it is reported by
# /api/ready and by `npm run verify:hardening`, so it cannot be on by accident and
# unnoticed. Nothing infers "production" from anything other than NODE_ENV: a
# missing NODE_ENV means development, which fails safe.

# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# Postgres connection string. `npm run infra:up` starts a matching container.
DATABASE_URL=postgresql://tally:tally@localhost:5432/tally
# Max pool connections per process (web/worker/scheduler each open their own).
DATABASE_POOL_MAX=10

# Server-side ceilings, applied by Postgres itself rather than by the client, so
# they hold even if a process stops waiting for its own query.
#
# statement_timeout: a single query that runs longer than this is cancelled. The
# ceiling exists because one pathological query would otherwise hold a pool
# connection indefinitely and, at DATABASE_POOL_MAX of them, stall the process.
# Raise it if you add a genuinely long analytical query; the pipeline's own long
# work happens in the worker, not in SQL.
DATABASE_STATEMENT_TIMEOUT_MS=15000
# idle_in_transaction_session_timeout: an open transaction sitting idle this long
# is killed. An abandoned transaction holds its row locks and blocks VACUUM.
DATABASE_IDLE_TX_TIMEOUT_MS=30000

# Separate database for the integration tests (§39). They TRUNCATE between tests,
# so this must NEVER point at a database holding real data. Leave it unset and
# `npm test` runs unit tests only, reporting the integration suites as skipped
# rather than passing them vacuously.
#   createdb tally_test   (or: docker exec tally-postgres createdb -U tally tally_test)
#   TEST_DATABASE_URL=postgresql://tally:tally@localhost:5432/tally_test npm run test:integration
# TEST_DATABASE_URL=postgresql://tally:tally@localhost:5432/tally_test

# -----------------------------------------------------------------------------
# QUEUE / REDIS (required — background jobs, §31)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Namespace prefix so multiple environments can share one Redis instance.
QUEUE_PREFIX=tally

# -----------------------------------------------------------------------------
# SECRETS / ENCRYPTION (required)
# -----------------------------------------------------------------------------
# 32-byte hex key (64 hex chars) used for AES-256-GCM encryption of stored
# OAuth tokens and provider credentials at rest (§6, §34).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# 32-byte hex secret used to derive session-cookie and CSRF signing keys.
# Generate the same way as ENCRYPTION_KEY. Rotating it logs everyone out.
SESSION_SECRET=

# -----------------------------------------------------------------------------
# EMAIL (required for verification + password reset, §4)
# -----------------------------------------------------------------------------
# Provider: `console` (dev — prints the email to stdout) or `resend`.
EMAIL_PROVIDER=console
EMAIL_FROM="Tally <no-reply@tally.app>"
# Required when EMAIL_PROVIDER=resend. https://resend.com/api-keys
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# AI PROVIDER (required for research angles, scripts, metadata, thumbnails)
# -----------------------------------------------------------------------------
# How Claude is reached. Both options run the same models; pick the one your
# account bills through.
#   anthropic — the first-party Claude API (default). Needs ANTHROPIC_API_KEY.
#   bedrock   — Claude on AWS Bedrock. Needs BEDROCK_REGION + AWS credentials.
AI_PROVIDER=anthropic

# --- AI_PROVIDER=anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for generation. Leave as-is unless you have a reason to change it.
ANTHROPIC_MODEL=claude-opus-5

# --- AI_PROVIDER=bedrock ---
# AWS region for Bedrock. Falls back to AWS_REGION / AWS_DEFAULT_REGION when
# unset. The Claude model below must be enabled for your account in this region
# (AWS console → Bedrock → Model access).
BEDROCK_REGION=us-east-1
# Bedrock namespaces model ids. Both `anthropic.claude-opus-5` and the bare
# `claude-opus-5` work — the prefix is added when missing.
BEDROCK_MODEL=anthropic.claude-opus-5
#
# There is deliberately no access key here. Bedrock credentials come from the
# standard AWS provider chain — environment variables, ~/.aws/credentials, an
# SSO cache, or an instance/container role — so they never enter Tally's own
# configuration (§33). Verify yours with: aws sts get-caller-identity
# The IAM principal needs bedrock:InvokeModel on the model above.

# Reasoning effort: low | medium | high | xhigh | max. Applies to both providers.
ANTHROPIC_EFFORT=high

# -----------------------------------------------------------------------------
# YOUTUBE / GOOGLE OAUTH (required for channel connect + publishing, §6)
# -----------------------------------------------------------------------------
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (type: Web application). Enable "YouTube Data API v3" and
# "YouTube Analytics API" on the project.
# Authorized redirect URI must be exactly: {APP_URL}/api/channels/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key for public/quota-only reads (trending, search) that need no user auth.
# Phase 11 link mode requires this: pasting a YouTube URL reads public metadata
# with no connected channel, so it cannot use the OAuth client above. Restrict the
# key to "YouTube Data API v3" in the Google console.
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# VOICEOVER (§11)
# -----------------------------------------------------------------------------
# `elevenlabs` or `mock`
VOICE_PROVIDER=mock
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# VISUALS / B-ROLL (§12)
# -----------------------------------------------------------------------------
# Comma-separated, in priority order: pexels,runway,mock
VISUAL_PROVIDERS=mock
# https://www.pexels.com/api/new/
PEXELS_API_KEY=
# https://dev.runwayml.com — used for generated (non-stock) visuals
RUNWAY_API_KEY=

# -----------------------------------------------------------------------------
# TALLY AI VIDEO MODELS (Phase 11 §9-§14; Phase 12 §2, §5, §14, §15)
# -----------------------------------------------------------------------------
# Tally offers four AI video models under its own names. Each is one vendor
# backend, reached directly, and each is bought with exactly one credential:
#
#   Tal 1.0 — Fast Model        DASHSCOPE_API_KEY
#   Tal 2.0 — Creators Model    MINIMAX_API_KEY
#   Tal 3.0 — Cinematic Model   SEEDANCE_API_KEY
#   Tal 3.1 — Ultra Model       GEMINI_API_KEY
#
# All four also generate images (Phase 12 §5), each on its vendor's own image
# endpoint behind the same single credential. Nothing extra is bought to make
# continuity reference stills, and a project makes them with the model it already
# selected rather than borrowing another model's look. The *_IMAGE_MODEL variables
# below select the version, so a newer release is a configuration change.
#
# The branded name is what a customer sees. The vendor behind it is deliberately
# absent from every customer-facing surface (Phase 12 §3) and appears only here,
# in logs, and in the operator endpoints /api/config/providers and
# `npm run verify:video-providers`.
#
# Which providers this deployment offers, comma-separated. Empty (the default)
# means stock footage only, which is the pre-Phase-11 behaviour — nothing changes
# for an existing deployment. The provider ids are:
#
#   qwen,minimax,seedance,veo
#
# Each vendor's own name for its service also works as an alias, so writing what
# the vendor console calls it resolves to the same backend: `dashscope`, `wan` and
# `alibaba` mean `qwen`; `ark` and `bytedance` mean `seedance`; `gemini` and
# `google` mean `veo`.
#
# This list is the server's allow-list. A provider absent here cannot be selected
# by any request, and a provider listed here without its credential is reported
# NOT_CONFIGURED in the UI rather than silently falling back (§10, §42).
VIDEO_GEN_PROVIDERS=

# Tal 1.0 — QwenCloud / Alibaba Cloud Model Studio (DashScope). One key covers
# both the video and the image endpoint.
# https://bailian.console.aliyun.com — International: dashscope-intl
DASHSCOPE_API_KEY=
# The regional endpoint. Use dashscope.aliyuncs.com for the mainland China region.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_VIDEO_MODEL=wan2.2-t2v-plus
DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-plus

# Tal 2.0 — MiniMax. https://platform.minimaxi.chat
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
# Its image endpoint is synchronous and lives on the same host and key.
MINIMAX_IMAGE_MODEL=image-01

# Tal 3.0 — Seedance, on Volcengine Ark. https://console.volcengine.com/ark
SEEDANCE_API_KEY=
# The regional endpoint. ap-southeast is the international one.
SEEDANCE_BASE_URL=https://ark.ap-southeast.volces.com/api/v3
SEEDANCE_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
# Ark serves images through the Seedream family, versioned independently from
# Seedance, on the same host and key.
SEEDANCE_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415

# Tal 3.1 — Google Veo, on the Google AI (Gemini) API, which needs its OWN key.
# The GOOGLE_CLIENT_ID/SECRET pair above is an OAuth client for acting as a user's
# YouTube channel and cannot authenticate Veo. The same key also reaches the image
# API, so no second Google integration exists (Phase 12 §15).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VEO_MODEL=veo-3.1-generate-preview
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# Deprecated (Phase 12 §14). Tally reached its video models through the fal.ai
# aggregator until Phase 12 replaced that route with the four direct providers
# above. Both variables are still parsed so an existing deployment that sets them
# boots unchanged, and both are ignored: `fal` is no longer a provider id, and
# listing it in VIDEO_GEN_PROVIDERS enables nothing. Safe to delete, and worth
# revoking the key at https://fal.ai/dashboard/keys once nothing else uses it.
FAL_KEY=
FAL_SEEDANCE_MODEL=

# -----------------------------------------------------------------------------
# MUSIC / SFX (§13)
# -----------------------------------------------------------------------------
# `freesound` or `mock`
MUSIC_PROVIDER=mock
# https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# -----------------------------------------------------------------------------
# TRANSCRIPTION / CAPTIONS (§14)
# -----------------------------------------------------------------------------
# `openai-whisper`, `deepgram`, or `mock`
TRANSCRIPTION_PROVIDER=mock
# Required when TRANSCRIPTION_PROVIDER=openai-whisper
OPENAI_API_KEY=
# Required when TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# RENDERING (§15)
# -----------------------------------------------------------------------------
# `ffmpeg`, `shotstack`, or `remotion-lambda`. There is no mock renderer: the
# default encodes locally with the bundled ffmpeg-static binary, so even a
# development build produces a real, playable MP4 (§42).
#
# ffmpeg          — no account, no per-minute cost, uses the worker's CPU. Fine
#                   for development and for low volume in production.
# shotstack       — hosted. One API key, no infrastructure, renders in parallel.
# remotion-lambda — your own render farm. Highest throughput, most setup.
RENDER_PROVIDER=ffmpeg
# Optional: a system ffmpeg (e.g. a hardware-accelerated build) instead of the
# bundled one. Must support libx264, aac and the subtitles filter.
FFMPEG_PATH=
# https://dashboard.shotstack.io — use the stage key for testing
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
# Remotion Lambda (self-hosted render farm) — required when
# RENDER_PROVIDER=remotion-lambda. The deployed site must expose a composition
# named `TallyVideo` accepting Tally's timeline document as its input props.
REMOTION_AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=

# -----------------------------------------------------------------------------
# THUMBNAILS (§16)
# -----------------------------------------------------------------------------
# Thumbnail headlines are burned onto the background with ffmpeg's `drawtext`,
# which needs a font *file* — unlike captions, which pass a font name to libass.
# Nothing is bundled (a licensed TTF does not belong in the repository), so a
# well-known system font is used when one is found: Impact or Arial Bold on
# Windows, DejaVu Sans Bold on Debian/Ubuntu, Impact on macOS.
#
# Set these to choose the faces explicitly — do that in production, because the
# system font that happens to exist on the host is not the channel's brand face.
# A path that is set but does not exist is reported as `not_configured`; it does
# NOT silently fall back, since an operator who names a file means that file.
#
# In a slim container image, install one first:
#   apt-get install -y fonts-dejavu-core
#   THUMBNAIL_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
THUMBNAIL_FONT_FILE=
# Optional. The subline face; defaults to a system body font, then to the
# headline face.
THUMBNAIL_FONT_FILE_BODY=

# -----------------------------------------------------------------------------
# OBJECT STORAGE (required — video/audio/image artifacts, §22)
# -----------------------------------------------------------------------------
# S3-compatible. `npm run infra:up` starts MinIO with these defaults.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tally-media
S3_ACCESS_KEY_ID=tallyminio
S3_SECRET_ACCESS_KEY=tallyminio
# true for MinIO / non-AWS S3, false for real AWS S3.
S3_FORCE_PATH_STYLE=true
# Lifetime (seconds) of generated signed download URLs.
S3_SIGNED_URL_TTL=3600

# -----------------------------------------------------------------------------
# BILLING (§24)
# -----------------------------------------------------------------------------
# `stripe` or `mock`
BILLING_PROVIDER=mock
# https://dashboard.stripe.com/apikeys (use sk_test_... while developing)
STRIPE_SECRET_KEY=
# From `stripe listen` or the dashboard webhook endpoint config.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the paid plans. Starter is free and needs no price.
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_SCALE=

# -----------------------------------------------------------------------------
# LIMITS / SAFETY (§34)
# -----------------------------------------------------------------------------
# Max bytes Tally will download from a remote asset URL.
MAX_REMOTE_ASSET_BYTES=524288000
# Comma-separated extra hostnames allowed for remote asset fetches. Provider
# CDNs are allow-listed in code; SSRF protection blocks everything else.
ASSET_FETCH_ALLOWED_HOSTS=
# Requests per minute per IP for unauthenticated auth endpoints.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Requests per minute per user for generation endpoints (AI spend control).
RATE_LIMIT_GENERATION_PER_MINUTE=20

# How many proxies sit in front of this instance.
#
# This is a security setting, not a tuning knob. `X-Forwarded-For` is a list a
# client can pre-fill, and a proxy APPENDS the peer it saw rather than replacing
# the header — so the only trustworthy entry is the Nth from the right, where N is
# the number of proxies genuinely in the path. Tally counts from the right using
# this value.
#
#   0  no proxy (direct to Node, or `next start` locally). The header is ignored
#      entirely and every IP-keyed rule shares one bucket — correct, because
#      anything in the header was fabricated.
#   1  one load balancer / reverse proxy in front (nginx, ALB, Vercel, Fly).
#   2+ a CDN in front of a load balancer. Count the hops you actually operate.
#
# Setting this HIGHER than the real hop count is the dangerous direction: it makes
# IP-keyed rate limits read a client-controlled value, and login/signup limits
# become bypassable by rotating a header. If unsure, leave it at 0.
TRUSTED_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# CONTENT SECURITY POLICY
# -----------------------------------------------------------------------------
# Extra origins added to the CSP `img-src`/`media-src` directives, comma-separated.
#
# Signed thumbnail and video URLs must be loadable by the browser. The storage
# origin is derived from S3_ENDPOINT automatically, so this is only needed when
# media is served from somewhere else — a CDN in front of the bucket, or AWS S3's
# regional hostnames, which cannot be derived. With neither set, the policy falls
# back to `https:`; naming the exact origins here is tighter.
#   CSP_IMG_ORIGINS=https://media.example.com,https://cdn.example.com
CSP_IMG_ORIGINS=

# -----------------------------------------------------------------------------
# OBSERVABILITY (§41)
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=debug
# `pretty` for local dev, `json` for production log aggregation.
LOG_FORMAT=pretty

# -----------------------------------------------------------------------------
# HEALTH / READINESS PROBES
# -----------------------------------------------------------------------------
# GET /api/health  — liveness. Touches nothing external; a failure means the
#                    process is dead and the container should be replaced.
# GET /api/ready   — readiness. Checks Postgres, Redis and the non-optional
#                    provider capabilities; 503 means drain traffic, not restart.
#                    `?mode=web|worker|full` selects which dependencies apply.
#
# Both are unauthenticated, because an orchestrator probe cannot log in. The
# verdict is always public; the per-dependency breakdown is not. Set this to a
# random string and send it as the `x-tally-probe-token` header to see the
# breakdown in production. Leave it unset in development, where the breakdown is
# shown to everyone (it is names and booleans — never values).
#   Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HEALTH_PROBE_TOKEN=
