{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidxir",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vidxir"
    },
    {
      "binding": "BACKEND",
      "service": "vidxir-backend"
    }
  ],
  "vars": {
    "APP_URL": "https://app.vidxir.com",
    "EMAIL_FROM": "\"Goodluck Efe @Vidxir AI\" <support@vidxir.com>",
    "EMAIL_PROVIDER": "resend",
    "GOOGLE_CLIENT_ID": "1091078203513-ucbo1aun3bbs44k5ier7t48m1osvsv25.apps.googleusercontent.com",
    "RENDER_EXECUTION": "cloudflare",
    "TRUSTED_PROXY_HOPS": "1",
    "VIDXIR_BLOCK_REAL_PUBLISH": "false",
    "VIDXIR_USE_MOCK_PROVIDERS": "false"
  },
  "routes": [
    {
      "pattern": "app.vidxir.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vidxir-production",
      "database_id": "90189a29-b52e-4723-b83e-1d0d7be77359",
      "migrations_dir": "drizzle-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vidxir-media-production"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATION",
        "class_name": "Coordination",
        "script_name": "vidxir-backend"
      }
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "RESEARCH_QUEUE",
        "queue": "vidxir-research"
      },
      {
        "binding": "PIPELINE_QUEUE",
        "queue": "vidxir-pipeline"
      },
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "vidxir-publish"
      },
      {
        "binding": "ANALYTICS_QUEUE",
        "queue": "vidxir-analytics"
      },
      {
        "binding": "MAINTENANCE_QUEUE",
        "queue": "vidxir-maintenance"
      }
    ]
  }
}
