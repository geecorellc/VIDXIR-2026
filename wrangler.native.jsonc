{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidxir-backend",
  "keep_vars": true,
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vidxir-production",
      "database_id": "90189a29-b52e-4723-b83e-1d0d7be77359",
      "migrations_dir": "drizzle-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vidxir-media-production"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RESEARCH_QUEUE",
        "queue": "vidxir-research"
      },
      {
        "binding": "PIPELINE_QUEUE",
        "queue": "vidxir-pipeline"
      },
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "vidxir-publish"
      },
      {
        "binding": "ANALYTICS_QUEUE",
        "queue": "vidxir-analytics"
      },
      {
        "binding": "MAINTENANCE_QUEUE",
        "queue": "vidxir-maintenance"
      }
    ],
    "consumers": [
      {
        "queue": "vidxir-research",
        "max_batch_size": 1,
        "max_retries": 10,
        "retry_delay": 30
      },
      {
        "queue": "vidxir-pipeline",
        "max_batch_size": 1,
        "max_retries": 10,
        "retry_delay": 30
      },
      {
        "queue": "vidxir-publish",
        "max_batch_size": 1,
        "max_retries": 10,
        "retry_delay": 30
      },
      {
        "queue": "vidxir-analytics",
        "max_batch_size": 1,
        "max_retries": 10,
        "retry_delay": 30
      },
      {
        "queue": "vidxir-maintenance",
        "max_batch_size": 1,
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  },
  "main": "cloudflare/backend.ts",
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "SELF",
      "service": "vidxir-backend"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATION",
        "class_name": "Coordination"
      },
      {
        "name": "RUNNERS",
        "class_name": "JobRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Coordination",
        "JobRunner"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "JobRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile.worker"
        }
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://app.vidxir.com",
    "EMAIL_FROM": "Vidxir AI <no-reply@vidxir.com>",
    "EMAIL_PROVIDER": "resend",
    "GOOGLE_CLIENT_ID": "1091078203513-ucbo1aun3bbs44k5ier7t48m1osvsv25.apps.googleusercontent.com",
    "LOG_LEVEL": "info",
    "RENDER_EXECUTION": "local",
    "VIDXIR_BLOCK_REAL_PUBLISH": "false",
    "VIDXIR_USE_MOCK_PROVIDERS": "false"
  }
}
